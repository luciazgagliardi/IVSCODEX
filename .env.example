# Copiá este archivo como .env y ajustá lo que necesites.
# Todos los valores son opcionales: si falta uno, se usa el default.

PORT=3000

# Origenes permitidos para CORS, separados por coma.
# Si abris el frontend desde el propio servidor no hace falta tocarlo.
CORS_ORIGENES=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5500

# Segundos, tamano y reintentos
TIMEOUT_MS=25000
MAX_BYTES=26214400
MAX_REDIRECCIONES=5

# Horas que dura el cache. Pone 0 para desactivarlo.
CACHE_HORAS=24

# Milisegundos minimos entre dos pedidos al mismo sitio de origen.
ESPERA_POR_HOST_MS=1500

# Presentate: si un organismo ve trafico raro, que sepa a quien escribirle.
USER_AGENT=JurisEtDeJure/1.0 (extractor personal de sentencias; contacto: cambiar@tu-mail.com)

# true = acepta cualquier dominio publico en vez de la lista blanca.
# Las protecciones contra IP privadas siguen activas igual.
PERMITIR_CUALQUIER_DOMINIO=false
