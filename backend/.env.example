# Copiá este archivo como .env (adentro de backend/) y ajustá lo que necesites.
# Todos los valores son opcionales: si falta uno, se usa el default.

PORT=3000

# Origenes permitidos para CORS, separados por coma.
# Si abrís el frontend desde el propio servidor (este backend sirviendo
# frontend/) no hace falta tocarlo. Si el frontend está publicado aparte
# (por ejemplo en GitHub Pages, en https://tu-usuario.github.io) agregá
# ese origen acá o el navegador va a bloquear las llamadas a la API.
CORS_ORIGENES=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5500

# API key de ScraperAPI para las busquedas del TSJ CABA.
# SCRAPER_API_KEY=pegá-la-clave-acá

# Segundos, tamano y reintentos
TIMEOUT_MS=25000
MAX_BYTES=26214400
MAX_REDIRECCIONES=5

# Horas que dura el cache. Pone 0 para desactivarlo.
CACHE_HORAS=24

# Carpeta donde se guarda el cache en disco. Por defecto es backend/cache
# (al lado de este archivo). Normalmente no hace falta tocarlo.
# DIR_CACHE=./cache

# Milisegundos minimos entre dos pedidos al mismo sitio de origen.
ESPERA_POR_HOST_MS=1500

# Presentate: si un organismo ve trafico raro, que sepa a quien escribirle.
USER_AGENT=JurisEtDeJure/1.0 (extractor personal de sentencias; contacto: cambiar@tu-mail.com)

# true = acepta cualquier dominio publico en vez de la lista blanca.
# Las protecciones contra IP privadas siguen activas igual.
PERMITIR_CUALQUIER_DOMINIO=false

# Solo para los tests automaticos: habilita descargar de IPs privadas
# (127.0.0.1, etc.). Nunca lo pongas en true en un servidor de verdad.
PERMITIR_RED_PRIVADA=false
